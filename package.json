    "test:unit": "vitest run",
    "test:e2e": "npm run tauri:build && node scripts/check-e2e-deps.js",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
